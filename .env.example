# =============================================================================
# CLOCKTOWER — ENVIRONMENT VARIABLES
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must NEVER be committed.
# =============================================================================

# --- DATABASE (Phase 2) ---
# Pooled connection string from Neon. Used by the app at runtime.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct (unpooled) connection. Used by Prisma Migrate only.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- AUTHENTICATION (Phase 3) ---
# Generate with: npx auth secret
AUTH_SECRET="replace-me-with-a-long-random-string"
# The app's own URL. http://localhost:3000 in development.
AUTH_URL="http://localhost:3000"

# --- IMAGE UPLOADS (Phase 11) ---
UPLOADTHING_TOKEN="replace-me"

# --- MAPS (Phase 11) ---
# NOTE the NEXT_PUBLIC_ prefix: this token IS sent to the browser, because
# the map renders client-side. It must be a PUBLIC Mapbox token with URL
# restrictions set in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN="pk.replace-me"
# Server-only secret token for geocoding. NO prefix = never reaches the browser.
MAPBOX_SECRET_TOKEN="sk.replace-me"